{
  "version": 1,
  "sources": {
    "wechat-work": {
      "enabled": false,
      "transport": "wechat-live",
      "adapter": "database-json",
      "platform": "wechat",
      "account_namespace": "operator-reviewed-account",
      "conversation_id": "reviewed-group@chatroom",
      "conversation_name": "已核对的工作群",
      "source_epoch": "reviewed-database-generation",
      "data_class": "real",
      "account_directory": "C:/Private/WeChat/account/db_storage/message",
