      "timeout_seconds": 15,
      "max_records": 20000,
      "shards": [
        {"id": "message-0", "path": "C:/Private/WeChat/account/db_storage/message/message_0.db", "key_id": "message/message_0.db"}
      ]
    }
  }
}
